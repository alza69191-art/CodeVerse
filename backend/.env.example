# Copy to backend/.env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./codeverse.db
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=60
REPOSITORY_STORAGE_PATH=./data/git
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://alza69191-art.github.io
